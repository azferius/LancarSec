{
    "proxy": {
        "cloudflare": true,
        "cloudflare_enforce_origin": false,
        "trusted_proxies": [
            "192.0.2.0/24",
            "2001:db8::/32"
        ],
        "max_body_size": 10485760,
        "hide_version_header": true,
        "ratelimit_time": 120,
        "adminsecret": "CHANGE_ME_ADMIN_SECRET",
        "apisecret": "CHANGE_ME_API_SECRET",
        "secrets": {
            "captcha": "CHANGE_ME_CAPTCHA_SECRET",
            "cookie": "CHANGE_ME_COOKIE_SECRET",
            "javascript": "CHANGE_ME_JS_SECRET"
        },
        "timeout": {
            "idle": 5,
            "read": 5,
            "write": 7,
            "read_header": 5
        },
        "ratelimits": {
            "challengeFailures": 40,
            "noRequestsSent": 10,
            "requests": 500,
            "unknownFingerprint": 150
        },
        "colors": [
            "0",
            "31"
        ]
    },
    "domains": [
        {
            "name": "example.com",
            "backend": "[::1]",
            "scheme": "http",
            "certificate": "/etc/lancarsec/tls/example.com.crt",
            "key": "/etc/lancarsec/tls/example.com.key",
            "webhook": {
                "url": "",
                "name": "LancarSec",
                "avatar": "https://example.com/lancarsec-avatar.png",
                "attack_start_msg": "A DDoS attack has been detected against your domain `{{domain.name}}`",
                "attack_stop_msg": "The DDoS attack against your domain `{{domain.name}}` has stopped"
            },
            "firewallRules": [
                {
                    "expression": "(http.path eq \"/captcha\")",
                    "action": "3"
                },
                {
                    "expression": "(http.path eq \"/js\")",
                    "action": "2"
                },
                {
                    "expression": "(ip.engine eq \"\" or ((ip.engine eq \"Firefox\" and http.user_agent contains \"chrome\") or (ip.engine eq \"Chromium\" and http.user_agent contains \"firefox\")))",
                    "action": "+1"
                },
                {
                    "expression": "(http.method ne \"GET\" and http.method ne \"POST\")",
                    "action": "+2"
                }
            ],
            "bypassStage1": 75,
            "bypassStage2": 250,
            "disableBypassStage3": 100,
            "disableRawStage3": 250,
            "disableBypassStage2": 50,
            "disableRawStage2": 75,
            "maxBodySize": 0
        },
        {
            "name": "9090.example.net",
            "backend": "1.1.1.1:9090",
            "scheme": "http",
            "certificate": "/etc/lancarsec/tls/9090.example.net.crt",
            "key": "/etc/lancarsec/tls/9090.example.net.key",
            "webhook": {
                "url": "",
                "name": "LancarSec",
                "avatar": "https://example.com/lancarsec-avatar.png",
                "attack_start_msg": "A DDoS attack has been detected against your domain `{{domain.name}}`",
                "attack_stop_msg": "The DDoS attack against your domain `{{domain.name}}` has stopped"
            },
            "firewallRules": [
                {
                    "expression": "(http.path eq \"/captcha\")",
                    "action": "3"
                },
                {
                    "expression": "(http.path eq \"/js\")",
                    "action": "2"
                },
                {
                    "expression": "(ip.engine eq \"\" or ((ip.engine eq \"Firefox\" and http.user_agent contains \"chrome\") or (ip.engine eq \"Chromium\" and http.user_agent contains \"firefox\")))",
                    "action": "+1"
                },
                {
                    "expression": "(http.method ne \"GET\" and http.method ne \"POST\")",
                    "action": "+2"
                }
            ],
            "bypassStage1": 75,
            "bypassStage2": 250,
            "disableBypassStage3": 100,
            "disableRawStage3": 250,
            "disableBypassStage2": 50,
            "disableRawStage2": 75,
            "maxBodySize": 52428800
        },
        {
            "name": "example.net",
            "backend": "1.1.1.1",
            "scheme": "http",
            "certificate": "/etc/lancarsec/tls/example.net.crt",
            "key": "/etc/lancarsec/tls/example.net.key",
            "webhook": {
                "url": "",
                "name": "LancarSec",
                "avatar": "https://example.com/lancarsec-avatar.png",
                "attack_start_msg": "A DDoS attack has been detected against your domain `{{domain.name}}`",
                "attack_stop_msg": "The DDoS attack against your domain `{{domain.name}}` has stopped"
            },
            "firewallRules": [
                {
                    "expression": "(http.path eq \"/captcha\")",
                    "action": "3"
                },
